# Non-secret deployment settings for the Ecommerce backend (read by .github/workflows/ci-cd.yml).
# deploy/gcp/bootstrap.sh prints the values after the one-time Google Cloud setup.
# Project IDs and numbers are identifiers, not credentials: access is controlled by Workload Identity Federation.
# While GCP_PROJECT_ID / GCP_PROJECT_NUMBER / ECOMMERCE_SITE_ID are empty, pushes to master only build and test.
# The demo shares the project, Cloud SQL instance and container registry of the booking demo.
GCP_PROJECT_ID=ilandeka-demos
GCP_PROJECT_NUMBER=608005285168
GCP_REGION=europe-west1
# Firebase Hosting site that serves the Vue frontend (https://<site>.web.app). The API only accepts browser calls from it,
# and the links in password reset emails point at it.
ECOMMERCE_SITE_ID=ilandeka-ecommerce
# Optional custom domain of the frontend, e.g. https://shop.example.com (leave empty to use the web.app address).
ECOMMERCE_PUBLIC_URL=
# Cloud Run instances that stay running. 1 means a visitor never waits for a cold start of about 15 seconds (costs about
# 13 USD or EUR per month); 0 saves that money and lets the service scale to zero when nobody visits.
CLOUD_RUN_MIN_INSTANCES=1
# Payments with Stripe in TEST mode. The test secret key and the webhook signing secret live only in Secret Manager: run
# "deploy/gcp/bootstrap.sh stripe" first (it stores both), then set STRIPE_ENABLED=true and push to master. The
# publishable key (pk_test_...) is not secret; it is set in the frontend repository. With false, checkout does not work
# in the demo and everything else does.
STRIPE_ENABLED=false
# Outgoing email (password reset links) from this Gmail account. The address is not a secret; its app password lives only
# in Secret Manager (ecommerce-mail-password, copied from the booking demo by bootstrap.sh, or stored with
# "bootstrap.sh mail"). With false, the demo cannot send email, so password resets do not work.
MAIL_ACCOUNT_ENABLED=true
MAIL_USERNAME=royale.league.test@gmail.com
